{
    "name": "orca-services/cakephp-swagger-ui",
    "description": "A CakePHP plugin for publishing Swagger-UIs based on Swagger API documentation files",
    "type": "cakephp-plugin",
    "minimum-stability": "stable",
    "homepage": "https://github.com/orca-services/cakephp-swagger-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "ORCA Services AG",
            "email": "development@orca-services.ch"
        },
        {
            "name": "Other contributors",
            "homepage": "https://github.com/orca-services/cakephp-swagger-ui/graphs/contributors",
            "role": "Contributors"
        }
    ],
    "support": {
        "email": "development@orca-services.ch",
        "source": "https://github.com/orca-services/cakephp-swagger-ui",
        "issues": "https://github.com/orca-services/cakephp-swagger-ui/issues"
    },
    "require": {
        "php": "^8.2",
        "cakephp/cakephp": "^5.3.1",
        "symfony/yaml": "^7.4.13"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3.0",
        "phpunit/phpunit": "^10.5.63"
    },
    "autoload": {
        "psr-4": {
            "SwaggerUi\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SwaggerUi\\Test\\": "./tests/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html build/coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
